{
  "name": "@sudobility/components",
  "version": "5.3.40",
  "description": "Reusable UI components and design system - Reorganized for better maintainability",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui/toast": {
      "types": "./dist/ui/toast/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate:cf-env": "curl -sL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/generate-cloudflare-env.ts -o /tmp/generate-cloudflare-env.ts && bunx tsx /tmp/generate-cloudflare-env.ts",
    "build": "NODE_ENV=production tsc && NODE_ENV=production vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --ignore-pattern 'dist' --ignore-pattern 'packages/*/dist' --ignore-pattern 'node_modules' --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test:unit": "vitest run",
    "test:ui": "vitest --ui",
    "prepublishOnly": "NODE_ENV=production bun run build"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "typescript",
    "tailwindcss"
  ],
  "author": "John Q Huang",
  "peerDependencies": {
    "@heroicons/react": ">=2.0.0",
    "@radix-ui/react-alert-dialog": ">=1.0.0",
    "@radix-ui/react-dialog": ">=1.0.0",
    "@radix-ui/react-label": ">=2.0.0",
    "@radix-ui/react-select": ">=2.0.0",
    "@radix-ui/react-slot": ">=1.0.0",
    "@radix-ui/react-switch": ">=1.0.0",
    "@radix-ui/react-tabs": ">=1.0.0",
    "@sudobility/design": "^1.1.66",
    "@sudobility/types": "^1.9.76",
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "i18next": ">=23.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-i18next": ">=14.0.0",
    "react-router-dom": ">=6.0.0",
    "tailwind-merge": ">=2.0.0",
    "web-vitals": ">=3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@heroicons/react": "~2.2.0",
    "@radix-ui/react-alert-dialog": "~1.2.1",
    "@radix-ui/react-dialog": "~1.3.1",
    "@radix-ui/react-label": "~2.1.17",
    "@radix-ui/react-select": "~2.4.1",
    "@radix-ui/react-slot": "~1.5.0",
    "@radix-ui/react-switch": "~1.4.1",
    "@radix-ui/react-tabs": "~1.2.1",
    "@sudobility/design": "^1.1.66",
    "@sudobility/types": "^1.9.76",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/jest-dom": "~6.10.0",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.8",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitejs/plugin-react": "~5.2.0",
    "ajv": "~8.20.0",
    "autoprefixer": "~10.6.1",
    "baseline-browser-mapping": "2.11.24",
    "browserslist": "4.29.0",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "i18next": "~25.10.10",
    "jsdom": "~26.1.0",
    "postcss": "~8.5.31",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "~16.6.6",
    "react-router-dom": "~7.18.4",
    "tailwind-merge": "~3.7.0",
    "tailwindcss": "~4.3.3",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "~3.2.7",
    "web-vitals": "~5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/mail_box_components.git"
  },
  "bugs": {
    "url": "https://github.com/sudobility/components/issues"
  },
  "homepage": "https://github.com/sudobility/components#readme",
